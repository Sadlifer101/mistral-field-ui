# Mistral UI — environment template (sanitized: names only, no values)
#
# Copy to `.env.local` and fill in. Vite only exposes variables prefixed with
# VITE_ to the browser bundle; everything else here belongs to the Convex
# deployment and must NOT be placed in this file.

# ---------------------------------------------------------------- frontend ---
# HTTP URL of your Convex deployment (required).
# Example shape: https://<deployment-name>.convex.cloud
VITE_CONVEX_URL=

# ----------------------------------------------------------------- backend ---
# The variables below are set on the Convex deployment (npx convex env set …),
# not in this file. They are listed so the backend side is documented in one
# place. Do not commit real values.

# Google OAuth web client credentials used by convex/auth.ts
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# Provided by Convex (used by convex/auth.ts allowedRedirectOrigins and convex/http.ts)
# CONVEX_SITE_URL=

# Only needed if the backend AI pipeline (convex/aiPipeline.ts) is enabled.
# The frontend never calls Gemini.
# GEMINI_API_KEY=

# AI-Studio deployment metadata from the original scaffold; not read by the app.
# APP_URL=
